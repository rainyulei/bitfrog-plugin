#!/usr/bin/env bash
# PreCompact hook: archive current session to the chain
# Mechanical archival — reads transcript, writes to .bitfrog/chain/
set -euo pipefail

PROJECT_ROOT="${CLAUDE_PROJECT_DIR:-.}"
BITFROG_DIR="${PROJECT_ROOT}/.bitfrog"
CHAIN_DIR="${BITFROG_DIR}/chain"

# Read hook input from stdin
# Claude Code may nest data under 'input' key or provide at top level
INPUT=$(cat)
TRANSCRIPT_PATH=$(echo "$INPUT" | python3 -c "
import sys,json
d=json.load(sys.stdin)
i=d.get('input',d)
print(i.get('transcript_path','') if isinstance(i,dict) else '')
" 2>/dev/null || echo "")

# If no transcript path or file not found, exit silently
if [ -z "$TRANSCRIPT_PATH" ] || [ ! -f "$TRANSCRIPT_PATH" ]; then
  echo '{}'
  exit 0
fi

# Ensure .bitfrog directory structure exists
mkdir -p "$CHAIN_DIR"
mkdir -p "${BITFROG_DIR}/memory"

# Auto-add .bitfrog/ to project .gitignore if not present
if [ -f "${PROJECT_ROOT}/.gitignore" ]; then
  grep -q '\.bitfrog/' "${PROJECT_ROOT}/.gitignore" 2>/dev/null || echo '.bitfrog/' >> "${PROJECT_ROOT}/.gitignore"
else
  echo '.bitfrog/' > "${PROJECT_ROOT}/.gitignore"
fi

# Determine session number (highest existing + 1, not count)
HIGHEST=$(find "$CHAIN_DIR" -name "session_*.md" 2>/dev/null | sed 's/.*session_0*//' | sed 's/\.md//' | sort -n | tail -1)
SESSION_NUM=$(( ${HIGHEST:-0} + 1 ))
SESSION_ID=$(printf "session_%03d" "$SESSION_NUM")

# Previous pointer = highest existing session (not assumed contiguous)
if [ -n "$HIGHEST" ] && [ "$HIGHEST" -gt 0 ]; then
  PREV_ID=$(printf "session_%03d" "$HIGHEST")
else
  PREV_ID="null"
fi

# Write session archive (safe: no heredoc with transcript content)
DATE=$(date +"%Y-%m-%d %H:%M")
ARCHIVE_PATH="${CHAIN_DIR}/${SESSION_ID}.md"

printf "# %s\nprevious: %s\ndate: %s\nproject: %s\n\n## Raw Transcript\n\n" \
  "$SESSION_ID" "$PREV_ID" "$DATE" "$PROJECT_ROOT" > "$ARCHIVE_PATH"
cat "$TRANSCRIPT_PATH" >> "$ARCHIVE_PATH"

echo '{}'
exit 0
